# AI Analyzer — Environment Variables
# IMPORTANT: Do NOT commit this file to Git. Add .env to .gitignore

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=superadmin1234
POSTGRES_DB=ai_analyzer
DATABASE_URL=postgresql://admin:superadmin1234@postgres:5432/ai_analyzer

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET=ai-analyzer-reports
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- JWT Secret (CHANGE THIS in production!) ---
SECRET_KEY=my_super_secret_devops_key

# --- Prometheus Alert Webhook Token (set this to a random string) ---
# Alertmanager must send this as header: X-Webhook-Token
ALERT_WEBHOOK_TOKEN=
